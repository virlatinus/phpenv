#!/usr/bin/env bash
#
# Summary: Display help for a command
#
# Usage: phpenv help [--usage] COMMAND
#        phpenv help --complete-commands [PREFIX]
#
# Parses and displays help contents from a command's source file.
#
# `phpenv help --complete-commands' prints `name:summary' pairs for every
# phpenv command whose name starts with PREFIX (all commands if PREFIX is
# omitted). It is meant for scripting/completion use, not interactive use.
#
# A command is considered documented if it starts with a comment block
# that has a `Summary:' or `Usage:' section. Usage instructions can
# span multiple lines as long as subsequent lines are indented.
# The remainder of the comment block is displayed as extended
# documentation.

set -e
[ -n "$PHPENV_DEBUG" ] && set -x

# Provide phpenv completions
if [ "$1" = "--complete" ]; then
  echo --usage
  exec phpenv-commands
fi

command_path() {
  local command="$1"
  type -P phpenv-"$command" phpenv-sh-"$command" | head -n1
}

extract_initial_comment_block() {
  sed -ne "
    /^#/ !{
      q
    }

    s/^#$/# /

    /^# / {
      s/^# //
      p
    }
  "
}

collect_documentation() {
  local awk
  awk="$(type -P gawk)" || awk="$(type -P awk)" || true
  if [ -z "$awk" ]; then
    echo "phpenv: cannot find awk" >&2
    return 1
  fi

  # shellcheck disable=SC2016
  "$awk" '
    /^Summary:/ {
      summary = substr($0, 10)
      next
    }

    /^Usage:/ {
      reading_usage = 1
      usage = usage "\n" $0
      next
    }

    /^( *$|       )/ && reading_usage {
      usage = usage "\n" $0
      next
    }

    {
      reading_usage = 0
      help = help "\n" $0
    }

    function escape(str) {
      gsub(/[`\\$"]/, "\\\\&", str)
      return str
    }

    function trim(str) {
      sub(/^\n*/, "", str)
      sub(/\n*$/, "", str)
      return str
    }

    END {
      if (usage || summary) {
        print "summary=\"" escape(summary) "\""
        print "usage=\"" escape(trim(usage)) "\""
        print "help=\"" escape(trim(help)) "\""
      }
    }
  '
}

documentation_for() {
  local filename
  filename="$(command_path "$1")"
  if [ -n "$filename" ]; then
    extract_initial_comment_block < "$filename" | collect_documentation
  fi
}

# Some 3rd-party plugin commands ship without a documentation comment (or,
# like phpenv-pie, are a compiled binary that can't carry one at all).
# Fall back to a short inferred description for those instead of leaving
# them blank in the listing.
declare -A fallback_summaries=(
  [man]="Open the manual page for a phpenv command or PHP extension (phpenv-man plugin)"
  [pie]="Manage PHP extensions via PIE, the PHP Installer for Extensions (phpenv-pie plugin)"
  [update]="Pull the latest php-build release definitions (php-build plugin)"
)

print_summary() {
  local command="$1"
  local width="$2"
  local summary usage help
  eval "$(documentation_for "$command")"
  [ -n "$summary" ] || summary="${fallback_summaries[$command]:-}"

  if [ -n "$summary" ]; then
    printf "   %-${width}s   %s\n" "$command" "$summary"
  else
    printf "   %s\n" "$command"
  fi
}

print_summaries() {
  local command
  local width=0
  for command; do
    [ "${#command}" -gt "$width" ] && width="${#command}"
  done

  for command; do
    print_summary "$command" "$width"
  done
}

print_help() {
  local command="$1"
  local summary usage help
  eval "$(documentation_for "$command")"
  [ -n "$help" ] || help="$summary"

  if [ -n "$usage" ] || [ -n "$summary" ]; then
    if [ -n "$usage" ]; then
      echo "$usage"
    else
      echo "Usage: phpenv ${command}"
    fi
    if [ -n "$help" ]; then
      echo
      echo "$help"
      echo
    fi
  else
    echo "Sorry, this command isn't documented yet." >&2
    return 1
  fi
}

print_usage() {
  local command="$1"
  local summary usage help
  eval "$(documentation_for "$command")"
  if [ -n "$usage" ]; then
    echo "$usage"
  else
    echo "Usage: phpenv ${command}"
  fi
}

if [ "$1" = "--complete-commands" ]; then
  command_prefix="${2:-}"
  seen=()
  shopt -s nullglob
  PATH_remain="$PATH"
  # traverse PATH to find "phpenv-" prefixed commands
  while true; do
    path="${PATH_remain%%:*}"
    if [ -n "$path" ]; then
      for phpenv_command in "${path}/phpenv-"*; do
        command_name="${phpenv_command##*/}"
        command_name="${command_name#phpenv-}"
        command_name="${command_name#sh-}"
        [[ $command_name == "${command_prefix}"* ]] || continue
        [[ " ${seen[*]} " != *" ${command_name} "* ]] || continue
        seen+=("$command_name")
        summary=""
        eval "$(extract_initial_comment_block < "$phpenv_command" | collect_documentation)"
        [ -n "$summary" ] || continue
        printf "%s:%s\n" "$command_name" "$summary"
      done
    fi
    [[ $PATH_remain == *:* ]] || break
    PATH_remain="${PATH_remain#*:}"
  done
  exit 0
fi

unset usage
if [ "$1" = "--usage" ]; then
  usage="1"
  shift
fi

if [ -z "$1" ] || [ "$1" == "phpenv" ]; then
  echo "Usage: phpenv [options] <command> [<args>...]"
  [ -n "$usage" ] && exit
  echo
  echo "Options:"
  printf "   %-14s   %s\n" "-v, --version" "Display the version of phpenv"
  printf "   %-14s   %s\n" "-h, --help" "Display this help message"
  printf "   %-14s   %s\n" "--debug" "Run in debug mode, printing every command as it executes"
  echo
  echo "Available commands (including 3rd-party ones from plugins):"
  print_summaries $(phpenv-commands | grep -v '^--version$')
  echo
  echo "See \`phpenv help <command>' for information on a specific command."
  echo "For full documentation, see: https://github.com/phpenv/phpenv#readme"
else
  command="$1"
  if [ -n "$(command_path "$command")" ]; then
    if [ -n "$usage" ]; then
      print_usage "$command"
    else
      print_help "$command"
    fi
  else
    echo "phpenv: no such command \`$command'" >&2
    exit 1
  fi
fi
